{
  "productName": "Ranger de Song",
  "version": "0.1.0",
  "identifier": "com.ranger.deesong",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run vite", 
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ranger de Song - DJ Music Organizer",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}